~ fdecl scan_num_cdecl()
~ fdecl print_num_cdecl(: var n)

~ func solve_linear(: var b : var c)
{
    ~ if (b) {
        ~ call print_num_cdecl(: (0 - c) / b)
    }

    ~ return 0
}

~ func solve_square_eq(: var a : var b : var c)
{
    ~ if (a) {
        ~ var D = b * b - 4 * a * c

        ~ var x_one = ((0 - b) + sqrt(: D)) / (2 * a)
        ~ var x_two = ((0 - b) - sqrt(: D)) / (2 * a)

        ~ call print_num_cdecl(: x_one)
        ~ call print_num_cdecl(: x_two)

        ~ return 0
    }

    ~ return call solve_linear(: b : c)
}

~ func main()
{
    ~ var a = 0
    ~ var b = 0
    ~ var c = 0

    ~ a = call scan_num_cdecl()
    ~ b = call scan_num_cdecl()
    ~ c = call scan_num_cdecl()

    ~ return call solve_square_eq(: a : b : c)
}
