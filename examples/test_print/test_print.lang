~ fdecl print(: var val)

~ func main()
{
    ~ call print(: 1        )
    ~ call print(: 22       )
    ~ call print(: 333      )
    ~ call print(: 4444     )
    ~ call print(: 55555    )
    ~ call print(: 666666   )
    ~ call print(: 7777777  )
    ~ call print(: 88888888 )
    ~ call print(: 999999999)
    ~ call print(: 88888888 )
    ~ call print(: 7777777  )
    ~ call print(: 666666   )
    ~ call print(: 55555    )
    ~ call print(: 4444     )
    ~ call print(: 333      )
    ~ call print(: 22       )
    ~ call print(: 1        )

    ~ call print(: 0 - 1        )
    ~ call print(: 0 - 22       )
    ~ call print(: 0 - 333      )
    ~ call print(: 0 - 4444     )
    ~ call print(: 0 - 55555    )
    ~ call print(: 0 - 666666   )
    ~ call print(: 0 - 7777777  )
    ~ call print(: 0 - 88888888 )
    ~ call print(: 0 - 999999999)
    ~ call print(: 0 - 88888888 )
    ~ call print(: 0 - 7777777  )
    ~ call print(: 0 - 666666   )
    ~ call print(: 0 - 55555    )
    ~ call print(: 0 - 4444     )
    ~ call print(: 0 - 333      )
    ~ call print(: 0 - 22       )
    ~ call print(: 0 - 1        )

    ~return 0
}
