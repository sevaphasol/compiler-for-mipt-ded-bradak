~ fdecl print_num_cdecl(: var n)
~ fdecl scan_num_cdecl()

~ fdecl smaller_cdecl(: var lhs : var rhs)
~ fdecl bigger_cdecl(: var lhs : var rhs)
~ fdecl smaller_or_eq_cdecl(: var lhs : var rhs)
~ fdecl bigger_or_eq_cdecl(: var lhs : var rhs)
~ fdecl equal_cdecl(: var lhs : var rhs)
~ fdecl not_equal_cdecl(: var lhs : var rhs)

~ arr heap[1000]
~ var heap_size = 0

~ func sift_up(: var idx)
{
    ~ while (1) {
        ~ var parent = (idx - 1) / 2

        ~ if ( call smaller_or_eq_cdecl(: idx : 0) ) {
            ~ return 0
        }
        ~ if ( call bigger_or_eq_cdecl(: heap[parent] : heap[idx]) ) {
            ~ return 0
        }

        ~ var tmp = 0
        ~ tmp = heap[idx]
        ~ heap[idx] = heap[parent]
        ~ heap[parent] = tmp
        ~ idx = (idx - 1) / 2
    }
}

~ func sift_down(: var idx)
{
    ~ var largest = idx
    ~ var left = 2 * idx + 1
    ~ var right = 2 * idx + 2

    ~ if (call smaller_cdecl(: left : heap_size)) {
        ~ if (call bigger_cdecl(: heap[left] : heap[largest])) {
            ~ largest = left
        }
    }
    ~ if (call smaller_cdecl(: right : heap_size)) {
        ~ if (call bigger_cdecl(: heap[right] : heap[largest])) {
            ~ largest = right
        }
    }

    ~ if (call not_equal_cdecl( : largest : idx)) {
        ~ var tmp = 0
        ~ tmp = heap[idx]
        ~ heap[idx] = heap[largest]
        ~ heap[largest] = tmp
        ~ call sift_down( : largest)
    }
}

~ func heap_push(: var n)
{
    ~ heap[heap_size] = n
    ~ heap_size = heap_size + 1
    ~ call sift_up(: heap_size - 1)
    
}

~ func heap_pop()
{
    ~ if (call equal_cdecl( : heap_size : 0)) {
        ~ return 0
    }

    ~ heap_size = heap_size - 1
    ~ heap[0] = heap[heap_size]
    ~ heap[heap_size] = 0
    ~ call sift_down(: 0)
}

~ func heap_top()
{
    ~ return heap[0]
}


~ func fill_heap()
{
    ~ var i = 10
    ~ while (i) {
        ~ call heap_push( : call scan_num_cdecl() )
        ~ i = i - 1
    }

    ~ return 0
}

~ func print_and_clear_heap()
{
    ~ var i = heap_size
    ~ while (i) {
        ~ call print_num_cdecl( : call heap_top() )
        ~ call heap_pop()
        ~ i = i - 1
    }

    ~ return 0
}

~ func main()
{
    ~ call fill_heap()
    ~ call print_and_clear_heap()

    ~ return 0
}
