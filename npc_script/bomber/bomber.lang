~ fdecl equal(: var lhs : var rhs)
~ fdecl not_equal(: var lhs : var rhs)
~ fdecl smaller(: var lhs : var rhs)
~ fdecl bigger(: var lhs : var rhs)
~ fdecl smaller_or_eq(: var lhs : var rhs)
~ fdecl bigger_or_eq(: var lhs : var rhs)
~ fdecl random_mod(: var max)

~ fdecl role_choose_id(: var id)

~ fdecl srv_id_clientId()
~ fdecl srv_r_setLvl_msg()
~ fdecl srv_r_setLvl_ok()

~ fdecl bomber_move_dx_dy(: var dx : var dy)
~ fdecl bomber_bomb_send()
~ fdecl bomber_binmsg_type_is_tick()
~ fdecl bomber_binmsg_type_is_hp()
~ fdecl bomber_hp_val()
~ fdecl bomber_binmsg_type_is_at()
~ fdecl bomber_at_x()
~ fdecl bomber_at_y()
