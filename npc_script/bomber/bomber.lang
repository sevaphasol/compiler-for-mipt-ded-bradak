~ fdecl lang_client_connect_cdecl(: var ip : var port : var prefix)
~ fdecl lang_client_alive_cdecl()
~ fdecl lang_client_set_dead_cdecl()
~ fdecl lang_client_read_next_cdecl()
~ fdecl lang_client_close_cdecl()

~ fdecl lang_pan_len_cdecl()
~ fdecl lang_pan_payload_i32_cdecl(: var offset)
~ fdecl lang_pan_payload_u32_cdecl(: var offset)
~ fdecl lang_pan_payload_bool_cdecl(: var offset)

~ fdecl lang_move_cdecl(: var prefix : var dx : var dy)
~ fdecl lang_attack_cdecl(: var prefix : var target)
~ fdecl lang_random_mod_cdecl(: var max)

~ fdecl equal_cdecl(: var lhs : var rhs)
~ fdecl not_equal_cdecl(: var lhs : var rhs)
~ fdecl smaller_cdecl(: var lhs : var rhs)
~ fdecl bigger_cdecl(: var lhs : var rhs)
~ fdecl smaller_or_eq_cdecl(: var lhs : var rhs)
~ fdecl bigger_or_eq_cdecl(: var lhs : var rhs)

~ fdecl lang_choose_role_cdecl(: var role)
~ fdecl lang_pan_prefix_is_cdecl(: var prefix)
~ fdecl lang_pan_type_is_cdecl(: var type)

